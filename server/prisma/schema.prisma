generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       HeroProfile?
  activities    Activity[]
  scores        GolfScore[]
  subscriptions Subscription[]
  contributions CharityContribution[]
  notifications Notification[]
  auditLogs     AuditLog[]
  preference    UserPreference?
  journeySteps  UserJourneyStep[]

  @@index([email])
  @@index([username])
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  dashboardLayout  String   @default("ADAPTIVE")
  emailNotifs      Boolean  @default(true)
  inAppNotifs      Boolean  @default(true)
  preferredCharity String   @default("Akshaya Patra Midday Meals")
  isPublicProfile Boolean  @default(true)
  aiMemoryJson     String   @default("{}")
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DomainEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  payload   String
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model ConfigurableAchievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  category    String
  iconName    String   @default("trophy")
  triggerKey  String
  threshold   Int      @default(1)
  xpReward    Int      @default(100)
  impactScore Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model UserJourneyStep {
  id          String   @id @default(cuid())
  userId      String
  stepKey     String
  title       String
  description String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepKey])
  @@index([userId])
}

model ImpactLedgerItem {
  id          String   @id @default(cuid())
  charityName String
  amount      Float
  metricType  String
  metricCount Int
  period      String
  proofUrl    String   @default("")
  status      String   @default("VERIFIED")
  createdAt   DateTime @default(now())
}

model IdempotencyRecord {
  key       String   @id
  path      String
  response  String
  createdAt DateTime @default(now())
}

model HeroProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  title       String   @default("Rising Hero")
  bio         String   @default("")
  avatarUrl   String   @default("")
  location    String   @default("")
  website     String   @default("")
  github      String   @default("")
  twitter     String   @default("")
  linkedin    String   @default("")
  level       Int      @default(1)
  xp          Int      @default(0)
  totalImpact Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       HeroSkill[]
  achievements Achievement[]
  badges       HeroBadge[]
  projects     Project[]

  @@index([level])
  @@index([xp])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  iconName  String   @default("code")
  createdAt DateTime @default(now())

  heroSkills HeroSkill[]
}

model HeroSkill {
  id           String   @id @default(cuid())
  heroId       String
  skillId      String
  proficiency  Int      @default(0)
  endorsements Int      @default(0)
  updatedAt    DateTime @updatedAt

  hero  HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  skill Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([heroId, skillId])
}

model Achievement {
  id            String   @id @default(cuid())
  heroId        String
  title         String
  description   String
  category      String
  iconName      String   @default("trophy")
  xpReward      Int      @default(100)
  impactScore   Int      @default(0)
  isVerified    Boolean  @default(false)
  relatedSkills String   @default("[]")
  achievedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  hero HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
  @@index([category])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  iconName    String
  rarity      String   @default("COMMON")
  requirement String
  createdAt   DateTime @default(now())

  heroBadges HeroBadge[]
}

model HeroBadge {
  id       String   @id @default(cuid())
  heroId   String
  badgeId  String
  earnedAt DateTime @default(now())

  hero  HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  badge Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([heroId, badgeId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  heroId    String
  type      String
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([heroId])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(cuid())
  heroId      String
  title       String
  description String
  url         String   @default("")
  tags        String   @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hero HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
}

// ⛳ Golf Score Intelligence & Performance Coaching
model GolfScore {
  id              String   @id @default(cuid())
  userId          String
  score           Int
  handicap        Float    @default(0.0)
  stablefordPoints Int     @default(36)
  courseName      String   @default("Delhi Golf Club")
  isFlagged       Boolean  @default(false)
  flagReason      String   @default("")
  playedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([playedAt])
}

// 💳 Subscription Intelligence
model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  planName           String    @default("Hero Champion Plan")
  status             String    @default("ACTIVE")
  priceMonthly       Float     @default(999.0)
  currency           String    @default("INR")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  nextRenewalAt      DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 💚 Live Charity Impact Engine & Interactive Impact Map
model Charity {
  id             String   @id @default(cuid())
  name           String   @unique
  category       String
  description    String
  location       String
  lat            Float
  lng            Float
  totalRaised    Float    @default(0.0)
  mealsProvided  Int      @default(0)
  treesPlanted   Int      @default(0)
  educationUnits Int      @default(0)
  verified       Boolean  @default(true)
  createdAt      DateTime @default(now())

  contributions CharityContribution[]
}

model CharityContribution {
  id            String   @id @default(cuid())
  userId        String
  charityId     String
  amount        Float
  mealsCount    Int      @default(0)
  treesCount    Int      @default(0)
  educationCount Int     @default(0)
  month         String
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charity Charity @relation(fields: [charityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([charityId])
}

// 🎲 Dynamic Draw Engine & Winner Verification
model DrawPool {
  id                String    @id @default(cuid())
  title             String
  month             String
  status            String    @default("OPEN")
  mode              String    @default("HYBRID") // RANDOM | WEIGHTED | HYBRID
  prizePool         Float     @default(50000.0)
  totalParticipants Int       @default(0)
  winnerId          String?
  winnerName        String?
  proofUrl          String?
  proofStatus       String    @default("NONE") // NONE | PENDING | VERIFIED | REJECTED
  proofVerifiedAt   DateTime?
  seed              String?
  createdAt         DateTime  @default(now())

  simulations DrawSimulation[]
}

model DrawSimulation {
  id            String   @id @default(cuid())
  drawId        String
  mode          String
  seed          String
  eligibleCount Int
  prizePool     Float
  resultJson    String
  createdAt     DateTime @default(now())

  draw DrawPool @relation(fields: [drawId], references: [id], onDelete: Cascade)
}

// 📜 Complete Audit Trail & Anomaly Detection
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String   @default("System")
  action    String
  module    String
  details   String
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([createdAt])
}

// 🧩 Feature Flags
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  description String   @default("")
  updatedAt   DateTime @updatedAt
}

// 🔔 Smart Notification Center
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 🤖 Level 4: Self-Improving Recommendation Engine
model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  reason      String
  dataSource  String
  confidence  Float    @default(0.95)
  actionUrl   String   @default("")
  ctaText     String   @default("View Action")
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// 📖 Level 4: Personalized Monthly Story
model MonthlyStory {
  id          String   @id @default(cuid())
  userId      String
  month       String
  year        Int
  summaryJson String
  shareToken  String   @unique
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ⚙️ Level 4: Background Job System
model BackgroundJob {
  id          String   @id @default(cuid())
  jobType     String
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  payload     String
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  scheduledAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([jobType])
}

// 🔮 Level 4: Predictive Insights Engine
model PredictiveInsight {
  id          String   @id @default(cuid())
  userId      String
  metricName  String
  estimate    String
  confidence  Float    @default(0.85)
  basis       String
  limitations String
  createdAt   DateTime @default(now())

  @@index([userId])
}

// 🚨 Level 4: "Needs Attention" Operational Admin Queue
model AdminQueueItem {
  id                String   @id @default(cuid())
  severity          String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  module            String
  reason            String
  entityId          String?
  recommendedAction String
  status            String   @default("PENDING") // PENDING | REVIEWED | RESOLVED
  createdAt         DateTime @default(now())

  @@index([status])
  @@index([severity])
}

// 🎲 Level 4: Draw Snapshot Integrity Model
model DrawSnapshot {
  id               String   @id @default(cuid())
  drawId           String
  eligibleCount    Int
  participantsJson String
  rulesJson        String
  verificationHash String
  createdAt        DateTime @default(now())

  @@index([drawId])
}

// 🎙️ Level 4: Digital Heroes Voice Copilot & Usage Tracker
model VoiceSession {
  id          String   @id @default(cuid())
  userId      String
  transcript  String
  intent      String   @default("GENERAL_QUERY")
  response    String
  toolUsed    String   @default("NONE")
  durationSec Float    @default(0.0)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model VoiceUsageLog {
  id            String   @id @default(cuid())
  userId        String
  sttCalls      Int      @default(1)
  ttsCalls      Int      @default(1)
  audioSec      Float    @default(0.0)
  estimatedCost Float    @default(0.002)
  provider      String   @default("WebSpeechAPI/GroundedVoiceEngine")
  createdAt     DateTime @default(now())

  @@index([userId])
}

model VoicePrivacySetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  voiceEnabled       Boolean  @default(true)
  voiceHistoryEnabled Boolean @default(true)
  speechRate         Float    @default(1.0)
  updatedAt          DateTime @updatedAt
}
