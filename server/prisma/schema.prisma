generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      HeroProfile?
  activities   Activity[]

  @@index([email])
  @@index([username])
}

model HeroProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  title       String   @default("Rising Hero")
  bio         String   @default("")
  avatarUrl   String   @default("")
  location    String   @default("")
  website     String   @default("")
  github      String   @default("")
  twitter     String   @default("")
  linkedin    String   @default("")
  level       Int      @default(1)
  xp          Int      @default(0)
  totalImpact Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       HeroSkill[]
  achievements Achievement[]
  badges       HeroBadge[]
  projects     Project[]

  @@index([level])
  @@index([xp])
}

model Skill {
  id         String   @id @default(cuid())
  name       String   @unique
  category   String
  iconName   String   @default("code")
  createdAt  DateTime @default(now())

  heroSkills HeroSkill[]
}

model HeroSkill {
  id           String   @id @default(cuid())
  heroId       String
  skillId      String
  proficiency  Int      @default(0)
  endorsements Int      @default(0)
  updatedAt    DateTime @updatedAt

  hero  HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  skill Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([heroId, skillId])
}

model Achievement {
  id           String   @id @default(cuid())
  heroId       String
  title        String
  description  String
  category     String
  iconName     String   @default("trophy")
  xpReward     Int      @default(100)
  impactScore  Int      @default(0)
  isVerified   Boolean  @default(false)
  relatedSkills String  @default("[]")
  achievedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  hero HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
  @@index([category])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  iconName    String
  rarity      String   @default("COMMON")
  requirement String
  createdAt   DateTime @default(now())

  heroBadges HeroBadge[]
}

model HeroBadge {
  id       String   @id @default(cuid())
  heroId   String
  badgeId  String
  earnedAt DateTime @default(now())

  hero  HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  badge Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([heroId, badgeId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  heroId    String
  type      String
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([heroId])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(cuid())
  heroId      String
  title       String
  description String
  url         String   @default("")
  tags        String   @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hero HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
}
